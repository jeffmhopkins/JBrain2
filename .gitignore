.dev-setup-stamps/
__pycache__/
*.pyc
.venv/
.pytest_cache/
.coverage
.ruff_cache/
node_modules/
dist/
# EXCEPT the panel firmware, which is committed on purpose. The box flashes these images
# off its own checkout rather than downloading a release, so `firmware/dist/` is shipped
# product rather than build output — see firmware/README.md "How it reaches the box".
!firmware/dist/

# Secrets must never be committed. Runtime config (incl. the xAI API key) lives
# in an untracked .env / environment variables, read via pydantic-settings.
.env
.env.*
!.env.example
*.key
secrets/

# Debug-console capability token an owner pastes for a session (never commit it).
.jbrain-debug-token

# Claude Code agent worktrees (harness scratch)
.claude/worktrees/

# ESP-IDF build output. sdkconfig is GENERATED from sdkconfig.defaults (which is committed);
# committing it would freeze whatever the last local build happened to negotiate.
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
