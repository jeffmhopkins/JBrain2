# flush_interval -1 disables response buffering so SSE log streams arrive
# line-by-line instead of in bursts.
#
# JBRAIN_SITE_ADDR is the bare domain in direct mode (Caddy fetches a Let's
# Encrypt cert — needs inbound 80/443), or "http://<domain>" in Cloudflare
# Tunnel mode (Caddy serves plain HTTP on :80 and TLS terminates at
# Cloudflare's edge; the tunnel reaches us here at http://proxy:80). It
# defaults to JBRAIN_DOMAIN in compose, so pre-tunnel installs are unchanged.

# Shared app handlers, imported by every site below (the public site, the optional LAN
# site and the owner site) so they serve the identical app from one definition. Two
# arguments: the site's ingress name, and the device identity (empty on every site but the
# owner site, where it is the verified client certificate's key hash). See header_up below.
(app) {
	encode zstd gzip

	# No other origin may frame the app: a jcode preview (same site, different origin)
	# must not be able to overlay a framed owner page and click through it. Only the app
	# sites import this snippet; the preview wildcard site deliberately does not, so a dev
	# app can still be framed by the PWA's preview pane.
	header Content-Security-Policy "frame-ancestors 'self'"
	header X-Frame-Options "SAMEORIGIN"

	# The host-mode jcode preview is served ONLY on its own <slug>-preview.<host>
	# subdomain (the preview site below). 404 the internal prefix on every app surface
	# (public + LAN) so a sandbox-run dev app can never be served on the owner origin.
	handle /__jcode_preview* {
		respond 404
	}

	# The jcode gateway bridge (models, completions, web, OCR) is for the jcode
	# container alone, which reaches the api directly at http://api:8000. Routed
	# publicly, its shared key — readable by every session — would keep working from
	# the internet after a share is revoked.
	handle /api/jcode/llm* {
		respond 404
	}

	handle /api/* {
		# The credential-exchange POSTs answer anyone, so cap their bodies here: an
		# unauthenticated caller could otherwise stream an unbounded JSON body into the api.
		# Scoped to exactly these paths, never /api/*, so uploads and imports keep their size.
		@unauthed_post {
			method POST
			path /api/auth/session /api/session/mint /api/intake/redeem /api/jcode/share/redeem /api/pairing/redeem
		}
		request_body @unauthed_post {
			max_size 64KB
		}
		reverse_proxy api:8000 {
			flush_interval -1
			# The api's per-client limits and panel nudges read this, and trust it only from
			# this container (backend api/client_ip.py). Set, not appended: whatever the
			# client sent is overwritten with the peer Caddy actually saw.
			header_up X-Real-IP {remote_host}
			# Which site the request came in on, and on the owner site which enrolled phone
			# sent it (docs/plans/OWNER_TUNNEL_PLAN.md §3.2). Set on every site, so whatever a
			# client sent is always overwritten and no site can forget to strip it; the api
			# trusts both only from this container.
			header_up X-JBrain-Ingress {args[0]}
			header_up X-JBrain-Device "{args[1]}"
		}
	}

	# The PWA's share target posts a shared photo here; its service worker answers it. A phone
	# whose worker is not running yet reaches the proxy instead, and lands in the composer with
	# nothing shared rather than on a 405 (frontend/public/panel-share-sw.js).
	handle /panel/share {
		redir /panel/send 303
	}

	handle {
		root * /srv/www

		# The member dashboard (JBrain360) is a second SPA entry served at /dash
		# (loaded inside the forked app's WebView). It has no client-side router,
		# so /dash and /dash/ both resolve to its built entry; its hash-named
		# assets are shared with the owner app under /assets/.
		@dash path /dash /dash/
		rewrite @dash /dash.html

		# The owner debug console is a third standalone entry; the clean /debug-console
		# path resolves to its built page (token-authed, opened from the PWA).
		@console path /debug-console /debug-console/
		rewrite @console /debug-console.html

		try_files {path} /index.html

		# The PWA's update entrypoints must always revalidate, while Vite's
		# hash-named assets are immutable — this pair is what makes every
		# launch pick up a new deploy.
		@entry path / /index.html /debug-console.html /sw.js /manifest.webmanifest /registerSW.js /panel-share-sw.js
		header @entry Cache-Control "no-cache"
		@hashed path /assets/* /workbox-*.js
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		file_server
	}
}

{$JBRAIN_SITE_ADDR} {
	# The owner debug console's page is not served under the public name: 404 its
	# entry here, while the LAN site below (which also imports app) still serves it.
	# That is a routing choice by Host, not a network gate — a client that reaches this
	# proxy and names the LAN host (or SNI) gets the page. It is safe only because the
	# page is static and every action it takes needs a debug token. The shared
	# hash-named /assets/* carry no secrets, and /api/debug/* stays reachable here (an
	# external assistant connects to it with a token).
	handle /debug-console* {
		respond 404
	}
	import app public ""
}

# Optional LAN site: when JBRAIN_LAN_ADDR is set (e.g. https://jbrain.local) the
# proxy entrypoint writes a site block here that serves the same app over HTTPS
# from Caddy's internal CA. This makes the Secure session cookie work on the
# local network even when the Cloudflare tunnel / internet is down. Unset -> no
# file is written, so this glob matches nothing and only the public site runs.
# See docs/runbooks/LOCAL_ACCESS.md.
import /etc/caddy/lan/*.caddy

# Optional host-mode jcode web preview: when JBRAIN_JCODE_PREVIEW_BASE_HOST is set the
# entrypoint renders a wildcard site here that routes <slug>-preview.<host> to the api's
# /__jcode_preview/<slug> (docs/archive/JCODE_PREVIEW_HOST_PLAN.md). Unset -> the glob matches
# nothing, so a stock deploy is unaffected.
import /etc/caddy/preview/*.caddy

# The owner site (docs/plans/OWNER_TUNNEL_PLAN.md §3.2): the owner app's private origin,
# rendered by the entrypoint only once the owner-keys one-shot has written its files, so a
# box without them serves exactly what it did before.
import /etc/caddy/owner/*.caddy
