# The `reader` sidecar: the upstream reader image, with its browser swapped for the pinned
# stable Chrome for Testing (deploy/chrome/). Upstream publishes only a `latest` that was
# built in September 2024, so its google-chrome-stable is a year of security releases behind,
# and this is the browser that renders arbitrary pages for web_fetch. Puppeteer finds the
# browser through PUPPETEER_EXECUTABLE_PATH, so repointing it is the whole swap.
# The upstream image is pinned by digest in docker-compose.yml, which passes it here.
ARG READER_BASE

FROM python:3.12-slim AS chrome
COPY deploy/chrome/ /chrome/
RUN python -I /chrome/fetch.py chrome /opt/chrome

FROM ${READER_BASE}
# Remove the stale browsers (the image carries both Google Chrome and Debian's chromium) so
# nothing can fall back to them. The packages go, their shared libraries stay: the pinned
# Chrome needs the same set.
RUN dpkg --purge google-chrome-stable chromium chromium-common chromium-sandbox \
    && rm -f /usr/bin/google-chrome-stable /usr/bin/google-chrome /usr/bin/chromium \
    && test ! -e /opt/google/chrome/chrome && test ! -e /usr/lib/chromium/chromium
# Upstream launches with `--single-process`, which current Chrome no longer survives: the
# first page kills the browser ("Target.createTarget: Target closed"). Dropping it puts each
# page back in its own renderer process, which is also the isolation a hostile page should
# get. The greps fail the build if upstream's launch code ever stops matching.
# Only the one token goes, and the launch args must still carry `--no-sandbox` afterwards.
RUN f=/app/build/services/puppeteer.js \
    && grep -q "'--single-process'" "$f" \
    && sed -i "s/'--single-process',\\?//" "$f" \
    && ! grep -q "single-process" "$f" && grep -q "'--no-sandbox'" "$f" && node --check "$f"
COPY --from=chrome /opt/chrome /opt/chrome
ENV PUPPETEER_EXECUTABLE_PATH=/opt/chrome/chrome
RUN /opt/chrome/chrome --version
