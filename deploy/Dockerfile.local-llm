# OPT-IN local model gateway for AMD Strix Halo (gfx1151).
#
# Rather than build llama.cpp ourselves (a moving target against the gfx1151
# Vulkan/ROCm runtime — Mesa/glslc versions, kernel quirks), we base on the
# community-maintained, hardware-tested llama.cpp image from the
# amd-strix-halo-toolboxes project, which ships a working `llama-server` kept in
# sync with llama.cpp master, and layer on llama-swap (multi-model OpenAI
# gateway). The base is selectable: the default is the Vulkan/RADV build (only
# needs /dev/dri); a `rocm-*` tag enables the ROCm/rocWMMA path (faster on
# gfx1151, but also needs /dev/kfd + seccomp=unconfined — see docker-compose.yml).
#
# Host prerequisites for gfx1151 (the image can't supply these), per the kyuz0
# toolbox guide:
#   - kernel >= 6.18.9 (avoid < 6.18.4 — gfx1151 stability bug)
#   - linux-firmware 20260110+ (avoid 20251125 — breaks ROCm on Strix Halo)
#
# SUPPLY CHAIN: this is a community image, and the `:vulkan-radv` TAG tracks
# llama.cpp master — so `llama-server` was a moving target and a gpt-oss tool-call
# grammar regression rode in unnoticed (tool-carrying turns crash the upstream). The
# default is now PINNED to a digest for a reproducible build; bump it deliberately
# (and re-verify gpt-oss tool calling after) rather than floating on the tag. Override
# LOCAL_LLM_BASE in .env to pin a different variant (e.g. a rocm-* digest).
#
# Current pin (2026-08-25): the `vulkan-radv_20260825T203415` build (immutable alias of
# the floating `vulkan-radv` tag it was cut from), bundling llama.cpp master of that date
# (~d222767 — the builder auto-detects the exact commit from `llama-server --version` and
# the box's /version reports it post-deploy). The checkpoint patch anchors and the
# `common_prompt_checkpoint` struct it depends on were confirmed unchanged across the whole
# f280b2698..d222767 range (no `server-context.cpp` edits), so 0001 re-applies cleanly.
# Live re-verification is PENDING the next deploy — the PWA update flow's smoke test (load +
# gpt-oss tool-call probe) gates it and rolls back on failure. The on-disk qwen/gpt-oss KV
# caches were written by the prior engine, so this bump also costs one re-prime per model on
# the first post-bump load (the state-file format can shift). Keep this digest and the
# compose default (deploy/docker-compose.yml LOCAL_LLM_BASE) in lockstep.
#
# This image is built only when the operator enables local hosting; it is never
# part of the default stack.

# Declared in the global scope (before the first FROM) so it is visible to the
# runtime FROM below; an ARG declared after a FROM is scoped to that stage and
# the later FROM would resolve it to blank.
ARG LOCAL_LLM_BASE=docker.io/kyuz0/amd-strix-halo-toolboxes@sha256:cea7c7e723b8feed67c5a4f4094652f4a0c63207be60584d8088eb5c6e62ef92

# Build llama-swap (pure-Go) in a throwaway stage so we don't need a toolchain
# in the runtime image. Pinned to a COMMIT, not a tag: llama-swap releases are
# tagged `vNNN`, which Go module versioning can't resolve (it wants semver with a
# matching major-version import path), so `go install ...@v250` fails with "no
# matching versions". This commit IS the v250 release.
#
# It carries the admin API (GET /running, POST /api/models/unload/{model}) the
# settings screen's loaded-state + unload buttons need, and `/logs/stream/{proxy,
# upstream,<model>}` behind /api/debug/llm/upstream-logs.
#
# Moved off v228 (a15e479) for two fixes that both bite this box:
#   - #875 / #878 — a browser tab left open on llama-swap's OWN web UI falls behind
#     on llama.cpp's verbose output, the bounded event bus fills, Broadcast blocks
#     Write, the stdout pipe backs up, and llama.cpp STALLS until the tab closes.
#   - #946 / #949 — "a request arriving during a process stop would hang forever":
#     the router decided start/stop from a snapshot that could go stale. That is
#     this box's normal workload, because the residency evictor unloads models
#     while requests keep arriving, and it is the best candidate for the upstream
#     timeouts and the wedged-after-unload state seen on 2026-08-20.
#
# VERIFIED before the bump, not assumed: the config this repo generates
# (jbrain.llm.llama_swap_config.render over the whole catalog) was parsed with
# v250's own `internal/config.LoadConfig` — 16 models, 2 groups, no error — and
# every route we call still exists at that tag.
FROM golang:1.23-bookworm AS swap
ENV GOTOOLCHAIN=auto
ARG LLAMA_SWAP_VERSION=60226b63776efac11e15828abe0bb302ec259699
RUN GOBIN=/out go install "github.com/mostlygeek/llama-swap@${LLAMA_SWAP_VERSION}"

# OPT-IN patched llama-server build. DEFAULT OFF: with PATCH_RESTORE_CHECKPOINT
# unset/0 this stage still builds but produces nothing the runtime copies, so the
# image is byte-for-byte the stock base binary — zero risk to the working build.
#
# When set to 1, this rebuilds ONLY the llama-server target from llama.cpp at the
# commit the base image's OWN binary reports (`llama-server --version`, read at
# build time — LLAMA_CPP_COMMIT is just the fallback for an unparseable version),
# with JBrain's patches applied by anchor (deploy/apply-llama-patches.sh). It
# builds INSIDE the base image so it reuses the base's proven gfx1151 Vulkan
# toolchain (glslc, headers, driver) — only generic build tools are added — and
# building at the base's own commit keeps the result ABI-matched to the base's
# shared libs (libggml*/libllama), which the overlaid binary links dynamically.
#
# WHY it exists: the sole patch (0001) preserves the slot's CONTEXT CHECKPOINTS
# across slot save/restore (a sidecar beside the slot file), which is what lets
# SWA/hybrid/recurrent models (qwen3.8) REUSE a disk-restored prompt instead of
# re-prefilling it — the ~166 s warm → sub-second qwen reload fix, validated
# end-to-end on a live hybrid model before shipping (deploy/patches/0001). The
# stock base can't do this; upstreaming is the long-term home, this is the bridge.
#
# UNVALIDATED on gfx1151 as committed — the first on-box build with the flag on is
# the test; the update flow's smoke-test + rollback protect the runtime if it fails.
FROM ${LOCAL_LLM_BASE} AS llama-build
ARG PATCH_RESTORE_CHECKPOINT=0
# EXPLICIT OVERRIDE ONLY, empty by default. The build checks out the commit the
# base image's own llama-server reports (`llama-server --version`, read in the RUN
# below) — the base links libggml*.so / libllama.so DYNAMICALLY and we overlay only
# the llama-server binary, so any other commit ships an ABI-incompatible binary that
# crashes at model load. Hand-pinned commits caused both 2026-08-24 smoke failures
# (c060ca974 against a 571d0d540 base; then a stale 571d0d540 fallback against the
# auto-updated base after upstream changed the --version format). An unparseable
# version is now a FAST, loud failure — a guessed commit wastes a full compile before
# the smoke test catches the mismatch — so set this (via LOCAL_LLM_LLAMA_COMMIT in
# .env) only to deliberately force a commit, e.g. for an exotic base variant.
ARG LLAMA_CPP_COMMIT=
COPY deploy/apply-llama-patches.sh /apply-llama-patches.sh
RUN set -eux; \
    mkdir -p /out; \
    if [ "${PATCH_RESTORE_CHECKPOINT}" != "1" ]; then \
        echo "PATCH_RESTORE_CHECKPOINT!=1 — skipping patched build (stock binary kept)"; \
        exit 0; \
    fi; \
    # The base ships a compiler but not the whole link/build chain (the rolling
    # image dropped `ld`: "collect2: fatal error: cannot find 'ld'", 2026-08-24),
    # and it is Fedora — apt-get does not exist there. Check every tool the build
    # actually invokes and install via whichever package manager is present. Plain
    # install is NOT enough when the image's RPM DB already claims the package
    # while its files are gone (binutils reports installed with /usr/bin/ld
    # missing — "Nothing to do"), so tools still missing after install get a
    # reinstall pass, and a final check hard-fails rather than dying mid-compile.
    tools_missing() { m=""; for t in git cmake c++ ld make; do command -v "$t" >/dev/null 2>&1 || m="$m $t"; done; printf '%s' "$m"; }; \
    if [ -n "$(tools_missing)" ]; then \
        echo "installing build tools (missing:$(tools_missing))"; \
        if command -v dnf >/dev/null 2>&1; then \
            dnf -y --setopt=install_weak_deps=False install git cmake gcc-c++ binutils make; \
            [ -z "$(tools_missing)" ] || dnf -y reinstall git cmake gcc-c++ binutils make || true; \
        elif command -v microdnf >/dev/null 2>&1; then \
            microdnf -y --setopt=install_weak_deps=0 install git cmake gcc-c++ binutils make; \
            [ -z "$(tools_missing)" ] || microdnf -y reinstall git cmake gcc-c++ binutils make || true; \
        elif command -v apt-get >/dev/null 2>&1; then \
            apt-get update && apt-get install -y --no-install-recommends git cmake build-essential; \
            [ -z "$(tools_missing)" ] || apt-get install -y --reinstall --no-install-recommends git cmake build-essential binutils || true; \
        else echo "FATAL: missing tools ($(tools_missing)) and no known package manager (dnf/microdnf/apt-get)"; exit 1; fi; \
        if [ -n "$(tools_missing)" ]; then echo "FATAL: build tools still missing after install/reinstall:$(tools_missing)"; exit 1; fi; \
    fi; \
    base_ver="$(llama-server --version 2>&1 || true)"; \
    # Two observed formats: "version: 10068 (571d0d540)" and, since upstream's
    # versioning rework, "version: 0.2.0-dev (build 10612, commit 758443071)".
    base_commit="$(printf '%s\n' "$base_ver" | sed -n 's/^.*version:.*[( ]commit \([0-9a-f]\{7,40\}\)).*$/\1/p' | head -n1)"; \
    [ -n "$base_commit" ] || base_commit="$(printf '%s\n' "$base_ver" | sed -n 's/^.*version:[^(]*(\([0-9a-f]\{7,40\}\)).*$/\1/p' | head -n1)"; \
    if [ -n "${LLAMA_CPP_COMMIT}" ]; then \
        echo "LLAMA_CPP_COMMIT override set — building at ${LLAMA_CPP_COMMIT} (base reports: ${base_commit:-unparsed})"; \
        base_commit="${LLAMA_CPP_COMMIT}"; \
    elif [ -n "$base_commit" ]; then \
        echo "building llama-server at the base image's own commit ${base_commit} (ABI-matched overlay)"; \
    else \
        echo "FATAL: could not parse the base llama-server commit from: $base_ver"; \
        echo "       Upstream changed the --version format again — add the new pattern here."; \
        echo "       Building at a guessed commit would ship an ABI-mismatched binary."; \
        exit 1; \
    fi; \
    git clone --filter=blob:none https://github.com/ggml-org/llama.cpp /llama; \
    git -C /llama checkout "${base_commit}"; \
    /apply-llama-patches.sh /llama; \
    cmake -S /llama -B /llama/build -DGGML_VULKAN=ON -DLLAMA_CURL=OFF -DCMAKE_BUILD_TYPE=Release; \
    cmake --build /llama/build --target llama-server -j"$(nproc)"; \
    # The executable alone is NOT the server: upstream builds shared and the whole
    # server (server-context.cpp — where the patches live) is libllama-server-impl.so,
    # with `llama-server` a ~12 KB main() stub. Overlaying only the stub ships an
    # image that silently runs the base's UNPATCHED libraries (observed live
    # 2026-08-24: patch built, overlaid, and never executed). Ship every built
    # lib*.so* (same commit as the base, so same sonames — a full ABI-consistent
    # set) alongside the stub, preserving the symlink chains.
    cp "$(find /llama/build -name llama-server -type f | head -n1)" /out/llama-server; \
    mkdir -p /out/lib; \
    find /llama/build -name 'lib*.so*' -exec cp -a {} /out/lib/ \; ; \
    [ -n "$(ls /out/lib 2>/dev/null)" ] || { echo "FATAL: build produced no shared libraries — layout changed?"; exit 1; }; \
    ls /out/lib | grep -q 'server-impl' || echo "NOTE: no libllama-server-impl in build output — static server layout? overlay will ship the executable alone"; \
    /out/llama-server --version 2>&1 | head -n1

FROM ${LOCAL_LLM_BASE}
ARG PATCH_RESTORE_CHECKPOINT=0

# llama-swap is a static Go binary — drops in next to the image's llama-server
# (which is on PATH; the generated config invokes it by name).
COPY --from=swap /out/llama-swap /usr/local/bin/llama-swap

# Overlay the patched llama-server ONLY when the opt-in build produced one. The
# build stage always creates /out; it holds a binary only when PATCH_RESTORE_
# CHECKPOINT=1 succeeded. The overlay MUST include the shared libraries: the
# `llama-server` on PATH is a ~12 KB main() stub and every line of server code —
# the patch included — lives in libllama-server-impl.so (plus its lib* siblings)
# under /usr/lib64. Replacing only the stub leaves the base's unpatched libraries
# serving, with the patch present-but-inert (the 2026-08-24 silent failure). The
# libs are built at the base's own commit, so overwriting the base's set is an
# ABI-consistent same-version swap; ldconfig refreshes the loader cache.
COPY --from=llama-build /out/ /tmp/llama-out/
RUN set -eu; \
    if [ -f /tmp/llama-out/llama-server ]; then \
        dst="$(command -v llama-server)"; \
        libdir="/usr/lib64"; [ -d "$libdir" ] || libdir="/usr/lib"; \
        echo "overlaying patched llama-server onto ${dst} (+ $(ls /tmp/llama-out/lib 2>/dev/null | wc -l) shared libs into ${libdir})"; \
        if [ -d /tmp/llama-out/lib ] && [ -n "$(ls /tmp/llama-out/lib)" ]; then \
            cp -a /tmp/llama-out/lib/. "${libdir}/"; \
            ldconfig || true; \
        fi; \
        install -m 0755 /tmp/llama-out/llama-server "${dst}"; \
    else \
        echo "no patched llama-server (PATCH_RESTORE_CHECKPOINT=${PATCH_RESTORE_CHECKPOINT}) — keeping stock"; \
    fi; \
    rm -rf /tmp/llama-out

EXPOSE 8080
