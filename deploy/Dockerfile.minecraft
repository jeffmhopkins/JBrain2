# The `minecraft` sidecar: Bedrock Dedicated Server behind a small control wrapper
# (docs/plans/MINECRAFT_BEDROCK_PLAN.md, M0a).
#
# The image holds ONLY the wrapper. Mojang's server is downloaded at container start
# into the data volume (deploy/minecraft/install.py), because Bedrock clients only join
# a server on their exact version and auto-update: following them has to be a restart,
# not an image rebuild. BDS is x86_64-only, which the box is.
#
# `debian:trixie-slim` for a glibc BDS links against (it needs nothing beyond libc,
# libm, libgcc_s and friends — checked with readelf on 1.26.52.3) and Debian's own
# python3. STDLIB ONLY, no pip: the wrapper is http.server, subprocess and zipfile.
#
# NOT egress-free, unlike sdr/endpoint: BDS verifies every player's Xbox Live sign-in
# (`online-mode`) and the wrapper downloads server updates. It runs on the HOST network
# (NetherNet needs the box's real address and LAN broadcast), so the control port is
# guarded by a bearer token rather than by topology, and the process is unprivileged.
#
# One compiled piece: `jbrain-predict` (deploy/minecraft/predict/), the map's "satellite"
# layer, built in its own stage against cubiomes (MIT, Cubitect) at a pinned commit, so
# the runtime image gains a binary and no compiler.
FROM debian:trixie-slim AS predict
ARG CUBIOMES_COMMIT=e61f90580cbdd883214a8054670dacae655e59c0
COPY deploy/minecraft/predict/predict.c /src/predict.c
RUN set -eux; \
    printf '%s' "${CUBIOMES_COMMIT}" | grep -Eq '^[0-9a-f]{40}$'; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates git gcc make libc6-dev; \
    git clone --filter=blob:none https://github.com/Cubitect/cubiomes /cubiomes; \
    git -C /cubiomes checkout "${CUBIOMES_COMMIT}"; \
    make -C /cubiomes libcubiomes; \
    gcc -O2 -Wall -Wextra -Werror -I/cubiomes -o /jbrain-predict /src/predict.c \
        /cubiomes/libcubiomes.a -lm; \
    cp /cubiomes/LICENSE /cubiomes.LICENSE

FROM debian:trixie-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# A fixed uid so the volume's ownership survives image rebuilds. /data is created and
# owned here so a fresh named volume inherits that ownership on first mount.
RUN useradd --uid 1000 --create-home --shell /usr/sbin/nologin mc \
    && mkdir -p /data && chown mc:mc /data

WORKDIR /app
COPY deploy/minecraft/install.py ./install.py
COPY deploy/minecraft/bds.py ./bds.py
COPY deploy/minecraft/server.py ./server.py
COPY deploy/minecraft/worlds.py ./worlds.py
COPY deploy/minecraft/leveldb.py ./leveldb.py
COPY deploy/minecraft/mapping.py ./mapping.py
COPY deploy/minecraft/probe-pack ./probe-pack
COPY deploy/minecraft/probe-rp ./probe-rp
COPY deploy/minecraft/jbrain-pack ./jbrain-pack
COPY --from=predict /jbrain-predict ./jbrain-predict
COPY --from=predict /cubiomes.LICENSE ./licenses/cubiomes.LICENSE

RUN python3 -c "import server, bds, install, worlds, leveldb, mapping"
# The prediction is only worth drawing if it is right: spots a real 1.26 server generated
# from this seed — a warm ocean (Java id 44) and a mangrove swamp (184) — must still
# predict as those biomes on the compiled binary.
RUN python3 -c "import mapping; p = mapping.Predictor(); seed = '7353120887189866808'; \
    assert p.grid(seed, 0, 1280, 384, 1, 4)[(1280, 384)][1] == 40; \
    assert p.grid(seed, 0, 832, 2560, 1, 4)[(832, 2560)][1] == 191"

USER mc
ENV PYTHONUNBUFFERED=1
EXPOSE 19132/tcp 19132/udp
VOLUME ["/data"]

# Health is the WRAPPER's, not the game's: during a first-boot download the game is not
# up yet, and a failing check would only add a restart to a slow install.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python3", "-c", "import os, sys, urllib.request; port = os.environ.get('MC_PORT', '8000'); sys.exit(0 if urllib.request.urlopen(f'http://127.0.0.1:{port}/healthz', timeout=3).status == 200 else 1)"]

CMD ["python3", "server.py"]
