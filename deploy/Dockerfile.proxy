# Build context is the repo root: the proxy image bundles the built PWA.
FROM node:22-slim AS frontend
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# Pinned to the version the tests run the Caddyfile against (.github/actions/setup-caddy):
# the owner site's gate leans on Caddy's TLS behaviour, so bump the two together.
FROM caddy:2.10.2
COPY deploy/Caddyfile /etc/caddy/Caddyfile
# Entrypoint renders the optional LAN site (JBRAIN_LAN_ADDR), host-preview wildcard
# site (JBRAIN_JCODE_PREVIEW_BASE_HOST) and owner site (once its keys exist) before
# starting Caddy.
COPY deploy/proxy-entrypoint.sh deploy/proxy-lan-conf.sh deploy/proxy-preview-conf.sh \
	deploy/proxy-publish-ca.sh deploy/proxy-owner-conf.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/proxy-entrypoint.sh /usr/local/bin/proxy-lan-conf.sh \
	/usr/local/bin/proxy-preview-conf.sh /usr/local/bin/proxy-publish-ca.sh \
	/usr/local/bin/proxy-owner-conf.sh
COPY --from=frontend /build/dist /srv/www
ENTRYPOINT ["proxy-entrypoint.sh"]
